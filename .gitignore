# third-party inputs: not redistributed (a junction or folder on each machine)
data/raw

# intermediate files: nothing enters git unless listed here. The census and connectivity runs (about 17 GB) stay
# local; the WDPA extract (M3_wdpa_andes.gpkg) must never enter git
data/interim/*
!data/interim/M1_gmba_andes.gpkg
!data/interim/M1_domains.gpkg

__pycache__/
*.pyc
*.aux.xml
.Rhistory
.RData
Rplots.pdf

.claude/
~$*
